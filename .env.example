# URL pública del sitio, sin barra final
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app

# Google Apps Script publicado como Web App (URL terminada en /exec)
# Se utiliza sólo del lado del servidor y no se expone al navegador
APPS_SCRIPT_URL=

# Clave compartida con la propiedad JOIN_SUBMISSION_SECRET del Apps Script.
JOIN_SUBMISSION_SECRET=

# Apps Script que crea sesiones de carga reanudable para el archivo histórico.
# Los archivos se envían directamente desde el navegador a Google Drive.
ARCHIVE_APPS_SCRIPT_URL=

# Clave privada generada por configurarArchivo(). Nunca se expone al navegador.
ARCHIVE_UPLOAD_SECRET=
